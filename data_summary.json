    "drug_targets": {
      "claim": "38 approved drug target genes",
      "data_source": "data/processed/benchmark/tier2_drug_targets.tsv",
      "verified": true
    }
  },
  "core_algorithm": {
    "name": "Noisy-OR Aggregation",
    "formula": "P(gene_causal) = 1 - (1-ε) ∏(1 - P_path)",
    "parameters": {
      "leak_probability": 0.01,
      "ld_correlation_penalty": 0.5,
      "annotation_overlap_penalty": 0.3
    },
    "implementation": "src/mechanism_graph/inference.py",
    "reference": "Pearl J (1988) Probabilistic Reasoning in Intelligent Systems"
  },
  "pipeline": {
    "workflow": "workflow/Snakefile",
    "stages": [
      {"rule": "download_gwas_sumstats", "output": "data/gwas/{trait}/sumstats.tsv.gz"},
      {"rule": "harmonize_sumstats", "output": "results/{trait}/harmonized_sumstats.tsv.gz"},
      {"rule": "define_loci", "output": "results/{trait}/loci_definitions.tsv"},
      {"rule": "run_susie", "output": "results/{trait}/variant_pips.tsv"},
      {"rule": "run_colocalization", "output": "results/{trait}/gene_tissue_coloc.tsv"},
      {"rule": "build_mechanism_graphs", "output": "results/{trait}/mechanism_graphs.json"},
      {"rule": "run_inference", "output": "results/{trait}/gene_rankings.tsv"},
      {"rule": "compute_calibration", "output": "results/{trait}/calibration_report.json"}
    ]
  },
  "reproduction_commands": {
    "quick_verification": "python scripts/reproduce_paper_claims.py",
    "full_pipeline": "snakemake --cores 8 all",
    "environment_setup": "conda env create -f environment.yml && conda activate mechanism-graphs"
  },
  "diseases_analyzed": [
