{
  "metadata": {
    "title": "Mechanism-First Causal Graphs: Data Summary",
    "description": "Complete data summary for reproducing all published results",
    "version": "1.2.0",
    "created": "2025-01-15",
    "zenodo_doi": "10.5281/zenodo.17877740"
  },
  "data_structure": {
    "total_size_gb": 50.2,
    "directories": {
      "data/raw": {
        "size_gb": 28.1,
        "description": "Source datasets for analysis",
        "contents": [
          "gwas_sumstats/ - GWAS summary statistics",
          "encode_ccre/ - ENCODE cCRE v3 annotations",
          "gtex_v8/ - GTEx v8 eQTL data",
          "eqtl_catalogue/ - eQTL Catalogue data",
          "ld_reference/ - 1000 Genomes LD panels",
          "chromatin_interactions/ - Hi-C/PCHi-C data"
        ]
      },
      "data/processed": {
        "size_gb": 0.04,
        "description": "Derived analysis results",
        "contents": [
          "locus_summary.tsv - Master 51-locus results",
          "calibration/ - ECE and reliability metrics",
          "benchmark/ - Gold standards and baselines",
          "mechanism_graphs/ - Example JSON graphs",
          "replication/ - Cross-study validation"
        ]
      },
      "data/external": {
        "size_gb": 62.1,
        "description": "External benchmark datasets",
        "contents": [
          "crispr_benchmark/ - Fulco 2019 CRISPR data",
          "opentargets_l2g/ - L2G baseline scores",
          "drug_targets/ - Drug target mappings",
          "abc/ - Activity-by-Contact predictions"
        ]
      }
    }
  },
